{
  "schemaVersion": 1,
  "id": "nolocalglow",
  "version": "${version}",
  "name": "NoLocalGlow",
  "description": "Hides glowing entity outlines on this client only.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.nolocalglow.NoLocalGlowClient"
    ]
  },
  "mixins": [
    {
      "config": "nolocalglow.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
